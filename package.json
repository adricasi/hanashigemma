{
  "name": "hanashigemma",
  "version": "0.1.0",
  "private": true,
  "description": "Low-anxiety Japanese conversation and immersion coach powered by Gemma",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && tsc -p src/client/tsconfig.json && node -e \"require('node:fs').cpSync('public', 'dist/public', { recursive: true })\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p src/client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  }
}
