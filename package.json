{
  "name": "hanashigemma",
  "version": "0.1.0",
  "private": true,
  "description": "Low-anxiety Japanese conversation and immersion coach powered by Gemma",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && tsc -p src/client/tsconfig.json && node -e \"require('node:fs').cpSync('public', 'dist/public', { recursive: true })\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p src/client/tsconfig.json --noEmit && tsc -p test/client/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  }
}
