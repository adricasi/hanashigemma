# Copy to .env for local development (`npm start` reads it if present). Never commit .env.
# Every setting is optional for the local Ollama backend; defaults are shown.
# The hosted demo gets GEMINI_API_KEY from GCP Secret Manager, never from a file.
GEMMA_BACKEND=ollama
# GEMMA_MODEL=gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434
# GEMINI_API_KEY=
PORT=8080
DAILY_TURN_CAP=500
PER_MINUTE_LIMIT=10
